<Window x:Class="Diffusion.Toolkit.Controls.AiReversePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="AI 反推 / 画面解构" Height="640" Width="760" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Width="96" Height="96" Margin="0,0,12,0">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" FontWeight="Bold" FontSize="15" Text="AI 分析结果"/>
                <TextBlock x:Name="StatusText" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="画面解构 (9 维)" FontWeight="Bold" Margin="0,4,0,4"/>
                <ItemsControl x:Name="DeconstructItems"/>

                <TextBlock Text="Reverse Prompt (创作提示词)" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBox x:Name="ReversePromptBox" TextWrapping="Wrap" AcceptsReturn="True" Height="90"
                         VerticalScrollBarVisibility="Auto"/>
                <Button x:Name="CopyReverseButton" Content="复制 Reverse Prompt" Width="160" HorizontalAlignment="Left"
                        Margin="0,4,0,0" Click="CopyReverseButton_Click"/>

                <TextBlock Text="Negative Prompt" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBox x:Name="NegativePromptBox" TextWrapping="Wrap" AcceptsReturn="True" Height="54"
                         VerticalScrollBarVisibility="Auto"/>
                <Button x:Name="CopyNegativeButton" Content="复制 Negative Prompt" Width="160" HorizontalAlignment="Left"
                        Margin="0,4,0,0" Click="CopyNegativeButton_Click"/>

                <TextBlock Text="主色卡" FontWeight="Bold" Margin="0,12,0,4"/>
                <ItemsControl x:Name="PaletteItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="关键词" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBox x:Name="KeywordsBox" TextWrapping="Wrap" AcceptsReturn="True" Height="54"
                         VerticalScrollBarVisibility="Auto"/>
                <Button x:Name="CopyKeywordsButton" Content="复制关键词" Width="160" HorizontalAlignment="Left"
                        Margin="0,4,0,0" Click="CopyKeywordsButton_Click"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Content="保存到资产库" Width="120" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <Button x:Name="RegenerateButton" Content="重新生成" Width="100" Margin="0,0,8,0" Click="RegenerateButton_Click"/>
            <Button x:Name="CloseButton" Content="关闭" Width="80" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
